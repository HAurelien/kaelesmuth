#!/bin/sh
# Check the vault before each commit. Switched on with:
#   git config core.hooksPath _tools/hooks
# Skip once with: git commit --no-verify
root=$(git rev-parse --show-toplevel) || exit 1
py=$(command -v python3 || command -v python)
if [ -z "$py" ]; then
  echo "pre-commit: Python not found, vault not checked." >&2
  exit 0
fi
"$py" "$root/_tools/check_vault.py" --errors-only
status=$?
if [ $status -ne 0 ]; then
  echo "" >&2
  echo "Commit stopped: fix the errors above, or commit with --no-verify." >&2
fi
exit $status
